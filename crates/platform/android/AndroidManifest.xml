<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest the packager fills in: the app's id, version, lowest API
     level, the permissions it asks for, its name, launcher icon and
     orientation, plain HTTP in a dev build, the links that open it, the
     library the shell loads, and the provider that serves a copied image. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{package}"
    android:versionCode="{version_code}"
    android:versionName="{version_name}">

    <uses-sdk android:minSdkVersion="{min_sdk}" android:targetSdkVersion="36" />
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x400003" android:required="true" />
    {permissions}

    <application
        android:label="{label}"
        {icon}
        {cleartext}
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name="dev.viso.VisoActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            {orientation}
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc">
            <meta-data android:name="dev.viso.lib_name" android:value="{lib}" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>{links}
        </activity>
        <provider
            android:name="dev.viso.VisoClipProvider"
            android:authorities="{package}.viso.clipboard"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
